PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db
JWT_SECRET=supersecretjwtkey_replace_in_production_123456
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=RAZORPAY_KEY_SECRET
# Email Configuration (Nodemailer SMTP)
# Leave empty for console development preview or provide your SMTP details (e.g. Gmail / Brevo / Sendgrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=NexStore Concierge
FROM_EMAIL=no-reply@nexstore.com
